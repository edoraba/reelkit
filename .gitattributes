# Normalize text files
* text=auto eol=lf

# Binary assets kept in plain git (small, licensed). Listed first so the LFS rules below win.
*.ttf binary
*.otf binary
*.woff2 binary
*.png binary
*.jpg binary
*.wav binary
*.ogg binary
*.mp3 binary

# Binary outputs of each post live in Git LFS (temporary storage, see docs/decisions.md D-005)
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
content/**/*.wav filter=lfs diff=lfs merge=lfs -text
content/**/*.png filter=lfs diff=lfs merge=lfs -text
content/**/*.jpg filter=lfs diff=lfs merge=lfs -text
