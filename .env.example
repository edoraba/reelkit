# Copy to .env and fill in. Never commit .env.

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# The Google Cloud project behind this key must NEVER have a billing account linked:
# on the free tier, requests over the limit get HTTP 429 and nothing can be charged.
# Note: on the free tier Google may use inputs and outputs to improve its models.
GEMINI_API_KEY=

# TTS provider: gemini | kokoro | piper (see docs/decisions.md D-003, D-029)
TTS_PROVIDER=gemini
# Gemini TTS model id, configurable because models move out of preview
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# House voice (D-030): Puck, chosen after the listening test
GEMINI_TTS_VOICE=Puck

# Whisper model used for word timestamps: small | medium
WHISPER_MODEL=medium

# Instagram Graph API (phase 6, Business or Creator account)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

FREESOUND_API_KEY=